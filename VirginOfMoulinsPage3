import SwiftUI

struct VirginOfMoulinsPage3: View {
    @State private var radius: CGFloat = 120 // slider-controlled size
    private let phi = (1.0 + sqrt(5.0)) / 2.0 // golden ratio

    var body: some View {
        VStack(spacing: 20) {

            GeometryReader { geo in
                let center = CGPoint(x: geo.size.width / 2, y: geo.size.height / 2)
                let points = pentagonPoints(center: center, radius: radius)

                Canvas { context, size in

                    // Draw the pentagon edges

                    var pentagon = Path()
                    pentagon.move(to: points[0])
                    for i in 1..<5 {
                        pentagon.addLine(to: points[i])
                    }
                    pentagon.closeSubpath()

                    context.stroke(
                        pentagon, 
                        with: .color(.blue), 
                        lineWidth: 3
                    )

                    // Draw one diagonal (0 -> 2) to illustrate the golden ratio 

                    var diagonal = Path()
                    diagonal.move(to: points[0])
                    diagonal.addLine(to: points[2])

                    context.stroke(
                        diagonal, 
                        with: .color(.red), 
                        lineWidth: 2
                    )

                }

            }
            .frame(height: 300)

            VStack(alignment: .leading, spacing: 10) {
                Text("Radius: \(Int(radius))")
                Slider(value: $radius, in: 60...160)

                let ratio = diagonalToSideRatio(radius: radius)
                Text(String(format: "d / s = %.5f", ratio))
                Text(String(format: "Golden Ratio (φ) ≈ %.5f", phi))
                Text(String(format: "Difference = %.8f", abs(ratio - phi)))
                    .foregroundColor(abs(ratio - phi) < 0.0001 ? .green : .red)
            }
            .padding(.horizontal)
        }
        .padding()
    }

    // Regular pentagon verticles from a circle

    private func pentagonPoints(center: CGPoint, radius: CGFloat) -> [CGPoint] {
        (0..<5).map { i in
            let angle = -Double.pi / 2 + Double(i) * (2.0 * Double.pi / 5.0)
            return CGPoint(
                x: center.x + radius * CGFloat(cos(angle)),
                y: center.y + radius * CGFloat(sin(angle))
            )
        }
    }

    private func diagonalToSideRatio(radius: CGFloat) -> Double {

        let r = Double(radius)
        let side = 2.0 * r * sin(Double.pi / 5.0)
        let diagonal = 2.0 * r * sin(2.0 * Double.pi / 5.0)
        return diagonal / side

        // The side length of a regular pentagon can be calculated from the radius (circumradius)
        //let sideLength = 2 * radius * sin(.pi / 5)
        // The diagonal length can be calculated using the golden ratio
        //let diagonalLength = sideLength * phi
        //return diagonalLength / sideLength
    }
}


