import SwiftUI

struct VirginOfMoulinsPage4: View {
    private enum HarmonicOrder: String, CaseIterable, Identifiable {
        case fifthThenFourth
        case fourthThenFifth

        var id: Self { self }

        var title: String {
            switch self {
            case .fifthThenFourth:
                return "4:6:8 (fifth -> fourth)"
            case .fourthThenFifth:
                return "3:4:6 (fourth -> fifth)"
            }
        }

        var triplet: [Int] {
            switch self {
            case .fifthThenFourth:
                return [4, 6, 8]
            case .fourthThenFifth:
                return [3, 4, 6]
            }
        }

        var firstIntervalLabel: String {
            switch self {
            case .fifthThenFourth:
                return "4:6 is the fifth"
            case .fourthThenFifth:
                return "3:4 is the fourth"
            }
        }

        var secondIntervalLabel: String {
            switch self {
            case .fifthThenFourth:
                return "6:8 is the fourth"
            case .fourthThenFifth:
                return "4:6 is the fifth"
            }
        }

        var heightFromBreadth: Double {
            switch self {
            case .fifthThenFourth:
                return 8.0 / 6.0
            case .fourthThenFifth:
                return 6.0 / 4.0
            }
        }
    }

    @State private var order: HarmonicOrder = .fifthThenFourth
    @State private var scaleFactor: Double = 2

    private var scaledTerms: [Int] {
        order.triplet.map { Int(Double($0) * scaleFactor) }
    }

    private var maxTerm: Int {
        scaledTerms.max() ?? 0
    }

    private var breadth: Double {
        Double(scaledTerms[1])
    }

    private var length: Double {
        breadth * 2.0
    }

    private var height: Double {
        breadth * order.heightFromBreadth
    }

    var body: some View {
        VStack(alignment: .leading, spacing: 16) {
            Text("Diapason (Octave) Proportion Study")
                .font(.title2.weight(.semibold))

            Picker("Order", selection: $order) {
                ForEach(HarmonicOrder.allCases) { current in
                    Text(current.title).tag(current)
                }
            }
            .pickerStyle(.segmented)

            VStack(alignment: .leading, spacing: 8) {
                Text("Scale factor: \(Int(scaleFactor))")
                Slider(value: $scaleFactor, in: 1...3, step: 1)
                Text("Scaled terms: \(scaledTerms[0]), \(scaledTerms[1]), \(scaledTerms[2])")
                Text(order.firstIntervalLabel)
                Text(order.secondIntervalLabel)
                Text("Largest term: \(maxTerm) (must be <= 27)")
                    .foregroundStyle(maxTerm <= 27 ? .green : .red)
            }

            Divider()

            VStack(alignment: .leading, spacing: 8) {
                Text("Single ratio family applied to building")
                    .font(.headline)
                Text(String(format: "Breadth = %.2f", breadth))
                Text(String(format: "Length (octave 1:2) = %.2f", length))
                Text(String(format: "Height from same family = %.2f", height))
                Text("Rule: do not mix a triple-based height into a double-based plan.")
                    .foregroundStyle(.secondary)
            }
        }
        .padding()
    }
}

